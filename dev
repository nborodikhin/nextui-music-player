def split_archive_targets(targets):
    selectors = []
    archives = []
    for target in targets:
        if target.lower().endswith(".zip"):
            archives.append(Path(target))
        else:
            selectors.append(target)
    if len(archives) > 1:
        raise DevError("only one pak zip can be installed at a time")
    archive = archives[0] if archives else None
    if archive and not archive.is_file():
        raise DevError("No such pak zip: " + str(archive))
    return selectors, archive


def command_install_or_run(args, should_run):
    targets, archive = split_archive_targets(args.targets)
    if not targets:
        if archive:
            raise DevError("installing a pak zip requires a device target")
        if should_run:
            targets = ["desktop"]
        else:
            raise DevError("install requires at least one target")
    full = args.full or args.delete or archive is not None

    only_desktop = all(platform_for_alias(target) == "desktop" for target in targets)
    if archive and only_desktop:
        raise DevError("installing a pak zip requires a device target")
    devices = [] if only_desktop else list_devices()
    platforms, device_targets = resolve_device_targets(
        targets, devices, allow_desktop=True
    )
    if not archive:
        runtime = container_runtime(args)
        build_platforms(platforms, runtime)

    by_platform = {}
    for device in device_targets:
        by_platform.setdefault(device.platform, []).append(device)

    failures = []
    with tempfile.TemporaryDirectory(prefix="music-player-pak-") as temp_dir:
        unpacked = None
        if archive:
            print("Unpacking " + str(archive), flush=True)
            unpacked = extract_package(archive, Path(temp_dir) / PAK_NAME)

        for platform, matching_devices in by_platform.items():
            package = unpacked
            if full and not package:
                try:
                    package = stage_package((platform,), strict=False)
                except DevError as error:
                    failures.append(str(error))
                    continue

            for device in matching_devices:
                try:
                    if package:
                        install_full(device, package, delete=args.delete)
                    else:
                        install_binary(device)
                    if should_run:
                        run_on_device(device)
                except DevError as error:
                    failures.append(str(error))

    if should_run and "desktop" in platforms:
        run_desktop()

    if failures:
        raise DevError("\n".join(failures))
    return 0


def command_install(args):
    return command_install_or_run(args, should_run=args.run)


def command_run(args):
    result = command_install_or_run(args, should_run=True)
    if args.follow:
        targets = args.targets
        if not targets or any(
            platform_for_alias(target) == "desktop" for target in targets
        ):
            raise DevError("--follow requires exactly one device target")
        log_args = argparse.Namespace(targets=targets, follow=True, lines=10)
        return command_log(log_args)
    return result


def command_log(args):
    selectors = args.targets or ["device"]
    devices = list_devices()
    _platforms, targets = resolve_device_targets(selectors, devices, allow_desktop=False)
    if len(targets) != 1:
        details = ", ".join(
            "{} ({})".format(device.serial, device.platform) for device in targets
        ) or "none"
        raise DevError("log requires exactly one device; resolved: " + details)
    device = targets[0]
    log_path = "/mnt/SDCARD/.userdata/{}/logs/music-player.txt".format(
        device.platform
    )
    command = ["tail", "-n", str(args.lines)]
    if args.follow:
        command.append("-f")
    command.append(log_path)
    action = "Following" if args.follow else "Reading"
    print("{} {}:{}".format(action, device.serial, log_path), flush=True)
    remote_command = shlex.join(command)
    return run_command(
        ["adb", "-s", device.serial, "shell", remote_command],
        check=False,
    ).returncode


