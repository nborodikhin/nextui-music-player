def desktop_setup_stale(dependency, marker):
    """True when the NextUI base build predates the current checkout."""
    if not marker.exists():
        return True
    stamp = dependency_stamp(dependency)
    return bool(stamp) and stamp.stat().st_mtime > marker.stat().st_mtime


