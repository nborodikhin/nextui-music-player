    nextui = nextui_dependency()
    nextui_root = nextui.root.resolve()
    desktop_root = nextui_root / "workspace" / "desktop"
    prefix_local = Path("/var/tmp/nextui")
    setup_marker = prefix_local / ".desktop_setup_ok"
    system = os.uname().sysname

    env = os.environ.copy()
    if system == "Linux":
        env["CROSS_COMPILE"] = "/usr/bin/"
        env["PREFIX"] = "/usr"
    elif system == "Darwin":
        env["CROSS_COMPILE"] = "/usr/local/bin/"
        env["PREFIX"] = "/opt/homebrew"
    else:
        raise DevError("Unsupported host OS: " + system)
    env["PREFIX_LOCAL"] = str(prefix_local)
    env["UNION_PLATFORM"] = "desktop"

    if desktop_setup_stale(nextui, setup_marker):
        print("Preparing NextUI desktop workspace...", flush=True)
        if system == "Darwin" and not os.access("/usr/local/bin/gcc", os.X_OK):
            run_command(
                ["sudo", str(desktop_root / "macos_create_gcc_symlinks.sh")],
                env=env,
