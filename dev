        run_command(
            ["make", "-C", str(nextui_root), "build", "PLATFORM=desktop"],
            env=env,
        )
        prefix_local.mkdir(parents=True, exist_ok=True)
        setup_marker.touch()
        print("Desktop workspace setup complete.")

    run_command(["make", "-C", str(desktop_root / "libmsettings"), "build"], env=env)
    run_command(
        [
            "make",
            "-C",
