def get_pids(device, process):
    lines = adb_shell(device, "pidof", process, check=False)
    pids = " ".join(lines).split()
    return [pid for pid in pids if pid.isdigit()]


def stop_player(device, restart):
    pids = get_pids(device, "musicplayer.elf")
    if not pids:
        return False
    if restart:
        print("Restarting Music Player on {}".format(device.serial), flush=True)
        adb_shell(device, "touch", RESTART_FLAG)
    adb_shell(device, "kill", "-KILL", *pids)
    return True


def wait_for_nextui(device, timeout=8.0):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        pids = get_pids(device, "nextui.elf")
        if pids:
            return pids
        time.sleep(0.25)
    return []


def launch_from_nextui(device):
    pids = wait_for_nextui(device)
    if not pids:
        raise DevError(
            "nextui.elf is not running on {}. Launch Music Player manually.".format(
                device.serial
            )
        )
    launch_command = "'{}/launch.sh'".format(remote_pak_path(device.platform))
    with tempfile.TemporaryDirectory(prefix="music-player-next-") as temp_dir:
        next_file = Path(temp_dir) / "next"
        next_file.write_bytes(launch_command.encode("utf-8"))
        adb(device, "push", str(next_file), "/tmp/next")
    adb_shell(device, "kill", "-KILL", *pids)


