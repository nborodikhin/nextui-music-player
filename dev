def parse_manifest(platforms):
    entries = []
    missing = []
    for line_number, raw_line in enumerate(MANIFEST.read_text().splitlines(), 1):
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue

        condition = None
        match = re.match(r"^\[([^]]+)\]\s+(.+)$", line)
        if match:
            condition, line = match.groups()
            if condition not in platforms:
                continue

        patterns = []
        if "{platform}" in line:
            patterns.extend(line.replace("{platform}", platform) for platform in platforms)
        else:
            patterns.append(line)

        for pattern in patterns:
            absolute_pattern = str(ROOT / pattern)
            matches = sorted(Path(path) for path in glob.glob(absolute_pattern, recursive=True))
            matches = [path for path in matches if path.is_file() or path.is_symlink()]
            if not matches:
                missing.append("{}:{}: {}".format(MANIFEST.name, line_number, pattern))
                continue
            for path in matches:
                resolved = path.resolve()
                try:
                    resolved.relative_to(ROOT)
                except ValueError:
                    raise DevError("Manifest entry escapes the repository: " + str(path))
                entries.append(path.relative_to(ROOT))
    return unique(entries), missing


def stage_package(platforms, strict):
    platforms = tuple(unique(platforms))
    if DIST_PAK.exists():
        shutil.rmtree(DIST_PAK)
    DIST_PAK.mkdir(parents=True, exist_ok=True)

    entries, missing = parse_manifest(platforms)
    if missing:
        message = "Manifest patterns with no matches:\n  " + "\n  ".join(missing)
        if strict:
            raise DevError(message)
        print("WARNING: " + message, file=sys.stderr)

    for relative in entries:
        source = ROOT / relative
        destination = DIST_PAK / relative
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, destination, follow_symlinks=True)

    if strict:
        actual = {
            path.relative_to(DIST_PAK)
            for path in DIST_PAK.rglob("*")
            if path.is_file() or path.is_symlink()
        }
        expected = set(entries)
        extra = sorted(actual - expected)
        absent = sorted(expected - actual)
        if extra or absent:
            lines = []
            if extra:
                lines.append("Unexpected files:\n  " + "\n  ".join(map(str, extra)))
            if absent:
                lines.append("Missing files:\n  " + "\n  ".join(map(str, absent)))
            raise DevError("\n".join(lines))

    return DIST_PAK


def create_zip(package_dir):
    DIST_DIR.mkdir(parents=True, exist_ok=True)
    if DIST_ZIP.exists():
        DIST_ZIP.unlink()
    with zipfile.ZipFile(DIST_ZIP, "w", compression=zipfile.ZIP_DEFLATED) as archive:
        for path in sorted(package_dir.rglob("*")):
            if path.is_file():
                archive.write(path, path.relative_to(package_dir))
    return DIST_ZIP


def extract_package(archive, destination):
    destination.mkdir(parents=True, exist_ok=True)
    with zipfile.ZipFile(archive) as bundle:
        for info in bundle.infolist():
            extracted = Path(bundle.extract(info, destination))
            mode = (info.external_attr >> 16) & 0o7777
            if mode:
                extracted.chmod(mode)
    return destination


