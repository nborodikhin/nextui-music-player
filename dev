def normalize_container_options(argv):
    argv = list(argv)
    if argv[:1] != ["docker"]:
        return argv
    separator = argv.index("--") if "--" in argv else len(argv)
    options = [
        (index, argv[index])
        for index in range(1, separator)
        if argv[index] in ("--docker", "--podman")
    ]
    if not options:
        return argv
    for index, _option in reversed(options):
        del argv[index]
    argv[1:1] = [option for _index, option in options]
    return argv


def main():
    parser = create_parser()
    args = parser.parse_args(normalize_container_options(sys.argv[1:]))
    if args.command is None:
        parser.print_help()
        return 0
    try:
        return args.handler(args)
    except DevError as error:
        print("ERROR: " + str(error), file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
