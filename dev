def update_selfupdate_header(repo_url):
    match = re.search(r"github\.com/(.+?)(?:\.git)?$", repo_url.rstrip("/"))
    if not match:
        raise DevError("cannot parse GitHub repo from " + repo_url)
    owner_repo = match.group(1)

    content = SELFUPDATE_HEADER.read_text()
    content = re.sub(
        r'(#define APP_GITHUB_REPO\s+)"[^"]+"',
        r'\1"{}"'.format(owner_repo),
        content,
    )
    SELFUPDATE_HEADER.write_text(content)
    print("src/selfupdate.h -> " + owner_repo)


def update_qr_code_header(repo_url):
    if QR_CODE_HEADER.exists():
        existing = QR_CODE_HEADER.read_text()
        if "// Embedded QR code PNG for " + repo_url in existing:
            print("src/qr_code_data.h already encodes {}, skipping".format(repo_url))
            return

    try:
        import qrcode
    except ImportError as error:
        raise DevError("qrcode not installed (pip install qrcode[pil])") from error

    qr = qrcode.QRCode(
        error_correction=qrcode.constants.ERROR_CORRECT_M,
        box_size=7,
        border=2,
    )
    qr.add_data(repo_url)
    qr.make(fit=True)
    image = qr.make_image().convert("RGB")
    width, height = image.size
    image.save(QR_CODE_PNG)

    if shutil.which("pngcrush"):
        with tempfile.NamedTemporaryFile(suffix=".png", delete=False) as temporary:
            temporary_path = Path(temporary.name)
        subprocess.run(
            [
                "pngcrush",
                "-brute",
                "-noreduce",
                str(QR_CODE_PNG),
                str(temporary_path),
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        if temporary_path.exists() and temporary_path.stat().st_size > 0:
            before = QR_CODE_PNG.stat().st_size
            shutil.move(str(temporary_path), QR_CODE_PNG)
            after = QR_CODE_PNG.stat().st_size
            print(
                "pngcrush: {} -> {} bytes ({} saved)".format(
                    before, after, before - after
                )
            )
        else:
            temporary_path.unlink(missing_ok=True)

    data = QR_CODE_PNG.read_bytes()
    lines = []
    for offset in range(0, len(data), 12):
        lines.append(
            "  "
            + ", ".join(
                "0x{:02x}".format(byte) for byte in data[offset : offset + 12]
            )
        )

    header = (
        "#ifndef QR_CODE_DATA_H\n"
        "#define QR_CODE_DATA_H\n"
        "\n"
        "// Embedded QR code PNG for {}\n".format(repo_url)
        + "// Generated from qr-code.png ({}x{} pixels)\n".format(width, height)
        + "static const unsigned char qr_code_png[] = {\n"
        + ",\n".join(lines)
        + "\n};\n"
        + "static const unsigned int qr_code_png_len = {};\n".format(len(data))
        + "\n"
        + "#endif // QR_CODE_DATA_H\n"
    )
    QR_CODE_HEADER.write_text(header)
    print("src/qr_code_data.h -> {}x{}, {} bytes".format(width, height, len(data)))


def version_create(pak, args):
    version = normalize_version(args.version)
    text = " ".join(args.text)
    if version in pak["changelog"]:
        raise DevError(
            "Version {} already exists. Use 'version update' to change its note.".format(
                version
            )
        )

    pak["version"] = version
    pak["changelog"] = {version: text, **pak["changelog"]}
    save_pak(pak)
    print("pak.json -> {}: {}".format(version, text))

    APP_VERSION_FILE.write_text(version)
    print("state/app_version.txt -> " + version)
    update_selfupdate_header(pak["repo_url"])
    update_qr_code_header(pak["repo_url"])
    return 0


def version_remove(pak, args):
    version = args.version
    if version not in pak["changelog"]:
        raise DevError("Version {} not found in changelog.".format(version))

    note = pak["changelog"][version]
    confirmation = input(
        'Remove {}: "{}". Type "Remove" to confirm: '.format(version, note)
    )
    if confirmation != "Remove":
        print("Aborted.")
        return 0

    was_current = pak["version"] == version
    del pak["changelog"][version]
    if was_current:
        if not pak["changelog"]:
            raise DevError("No versions left after removal.")
        new_version = latest_version(pak)
        pak["version"] = new_version
        APP_VERSION_FILE.write_text(new_version)
        print("Current version updated to " + new_version)

    save_pak(pak)
    print("Removed {}.".format(version))
    return 0


