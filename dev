class DevError(Exception):
    pass


class CommandHelpFormatter(argparse.HelpFormatter):
    def _format_action(self, action):
        if isinstance(action, argparse._SubParsersAction):
            format_action = super()._format_action
            return "".join(
                format_action(command) for command in action._get_subactions()
            )
        return super()._format_action(action)


@dataclass(frozen=True)
class Device:
    serial: str
    state: str
    platform: str = "unknown"
    hardware: str = "-"


def load_container_runtime():
    runtime = DEFAULT_CONTAINER_RUNTIME
    if not DEV_CONFIG_FILE.exists():
        return runtime

    for line_number, raw_line in enumerate(
        DEV_CONFIG_FILE.read_text(encoding="utf-8").splitlines(), start=1
    ):
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        if "=" not in line:
            raise DevError(".dev:{}: expected KEY=VALUE".format(line_number))
        key, value = (part.strip() for part in line.split("=", 1))
        if key != "CONTAINER_RUNTIME":
            raise DevError(".dev:{}: unknown setting {}".format(line_number, key))
        runtime = value

    if runtime not in ("docker", "podman"):
        raise DevError(".dev: CONTAINER_RUNTIME must be docker or podman")
    return runtime


def container_runtime(args):
    return args.container_runtime or load_container_runtime()


def run_command(args, cwd=ROOT, env=None, capture=False, check=True, stdin=None):
    if capture:
        result = subprocess.run(
            args,
            cwd=str(cwd),
            env=env,
            input=stdin,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
    else:
        result = subprocess.run(
            args,
            cwd=str(cwd),
            env=env,
            input=stdin,
            check=False,
        )
    if check and result.returncode:
        if capture and result.stderr:
            sys.stderr.write(result.stderr.decode(errors="replace"))
        raise DevError("Command failed: " + " ".join(shlex.quote(str(a)) for a in args))
    return result


def adb(device, *args, check=True):
    """Run ADB and return stdout as a list of lines.

    ADB emits CRLF on some hosts; carriage returns are removed before splitting.
    """
    command = ["adb"]
    if device is not None:
        command.extend(["-s", device.serial])
    command.extend(str(arg) for arg in args)
    result = run_command(command, capture=True, check=check)
    return result.stdout.decode(errors="replace").replace("\r", "").splitlines()


def adb_shell(device, *args, check=True):
    """Run one safely quoted device command and return normalized output lines."""
    command = shlex.join(str(arg) for arg in args)
    return adb(device, "shell", command, check=check)


def list_devices(detect_platforms=True):
    devices = []
    for line in adb(None, "devices")[1:]:
        fields = line.split()
        if len(fields) < 2:
            continue
        serial, state = fields[:2]
        device = Device(serial=serial, state=state)
        if state == "device" and detect_platforms:
            device = detect_device(device)
        devices.append(device)
    return devices


def detect_device(device):
    cpuinfo = "\n".join(adb_shell(device, "cat", "/proc/cpuinfo", check=False))
    platform = "unknown"
    hardware = "-"
    for identifier, candidate in CPUINFO_PLATFORMS.items():
        if identifier in cpuinfo:
            platform = candidate
            hardware = identifier
            break

    return Device(
        serial=device.serial,
        state=device.state,
        platform=platform,
        hardware=hardware,
    )


def normalize_alias(value):
    return re.sub(r"[\s_-]+", "", value).lower()


def platform_for_alias(value):
    key = normalize_alias(value)
    for platform, aliases in ALIASES.items():
        if any(key == normalize_alias(alias) for alias in aliases):
            return platform
    return None


def unique(values):
    return list(dict.fromkeys(values))


def resolve_build_platforms(values, default=("desktop",), allow_all=True):
    values = values or list(default)
    platforms = []
    for value in values:
        key = normalize_alias(value)
        if key == "all":
            if not allow_all:
                raise DevError("'all' is not valid for this command")
            platforms.extend(ALL_PLATFORMS)
            continue
        platform = platform_for_alias(key)
        if not platform:
            raise DevError("Unknown platform: " + value)
        platforms.append(platform)
    return unique(platforms)


def resolve_dist_platforms(values):
    values = values or ["all"]
    platforms = []
    for value in values:
        key = normalize_alias(value)
        if key == "all":
            platforms.extend(DEVICE_PLATFORMS)
            continue
        platform = platform_for_alias(key)
        if platform not in DEVICE_PLATFORMS:
            raise DevError("Invalid distribution platform: " + value)
        platforms.append(platform)
    return unique(platforms)


def resolve_device_targets(values, devices, allow_desktop):
    ready = [device for device in devices if device.state == "device"]
    by_serial = {device.serial: device for device in devices}
    build_platforms = []
    targets = []

    for value in values:
        key = normalize_alias(value)
        if key == "device":
            selected = [device for device in ready if device.platform in DEVICE_PLATFORMS]
            if not selected:
                raise DevError("No supported ADB devices are connected")
            targets.extend(selected)
            build_platforms.extend(device.platform for device in selected)
            continue

        platform = platform_for_alias(key)
        if platform:
            if platform == "desktop":
                if not allow_desktop:
                    raise DevError("desktop is not valid for this command")
                build_platforms.append(platform)
                continue
            selected = [device for device in ready if device.platform == platform]
            if not selected:
                raise DevError("No connected device matches " + platform)
            targets.extend(selected)
            build_platforms.append(platform)
            continue

        device = by_serial.get(value)
        if not device:
            raise DevError("Unknown platform, alias, or ADB serial: " + value)
        if device.state != "device":
            raise DevError("ADB device {} is {}".format(value, device.state))
        if device.platform not in DEVICE_PLATFORMS:
            raise DevError("Could not detect the platform for ADB device " + value)
        targets.append(device)
        build_platforms.append(device.platform)

    targets = list({device.serial: device for device in targets}.values())
    return unique(build_platforms), targets


def run_container(runtime, platform, command, check=True):
    container_command = [runtime, "run"]
    if sys.stdin.isatty() and sys.stdout.isatty():
        container_command.append("-it")
    container_command.extend(
        [
            "-v",
            "{}:/root/workspace".format(ROOT.parent),
            "--rm",
            "ghcr.io/loveretro/{}-toolchain".format(platform),
        ]
    )
    container_command.extend(command)
    return run_command(container_command, check=check)


def build_device(platform, runtime):
    build_dir = ROOT / "src" / "build" / platform
    build_dir.mkdir(parents=True, exist_ok=True)
    if platform == "tg5050":
        aac_library = ROOT / "bin" / platform / "libfdk-aac.so.1"
        if not aac_library.exists():
            raise DevError("Missing {}".format(aac_library.relative_to(ROOT)))

        staged = build_dir / aac_library.name
        if not staged.exists():
            print("Copying {}".format(aac_library.relative_to(ROOT)))
            shutil.copy2(aac_library, staged)

        link = build_dir / "libfdk-aac.so"
        if not link.exists() or not link.is_symlink:
            print("Symlinking {}".format(link.relative_to(ROOT)))
            link.unlink(missing_ok=True)
            link.symlink_to(aac_library.name)

    run_container(
        runtime,
        platform,
        [
            "make",
            "-C",
            "/root/workspace/{}/libmsettings".format(platform),
            "build",
            "CROSS_COMPILE=aarch64-nextui-linux-gnu-",
            "PREFIX=/opt/nextui",
            "PREFIX_LOCAL=/opt/nextui",
        ],
    )
    run_container(
        runtime,
        platform,
        [
            "make",
            "-C",
            "/root/workspace/nextui-music-player/src",
            "PLATFORM={}".format(platform),
        ],
    )


def build_desktop():
    nextui_root = ROOT.parent.parent
    desktop_root = nextui_root / "workspace" / "desktop"
    prefix_local = Path("/var/tmp/nextui")
    setup_marker = prefix_local / ".desktop_setup_ok"
    system = os.uname().sysname

    env = os.environ.copy()
    if system == "Linux":
        env["CROSS_COMPILE"] = "/usr/bin/"
        env["PREFIX"] = "/usr"
    elif system == "Darwin":
        env["CROSS_COMPILE"] = "/usr/local/bin/"
        env["PREFIX"] = "/opt/homebrew"
    else:
        raise DevError("Unsupported host OS: " + system)
    env["PREFIX_LOCAL"] = str(prefix_local)
    env["UNION_PLATFORM"] = "desktop"

    if not setup_marker.exists():
        print("Preparing NextUI desktop workspace (one-time setup)...", flush=True)
        if system == "Darwin" and not os.access("/usr/local/bin/gcc", os.X_OK):
            run_command(
                ["sudo", str(desktop_root / "macos_create_gcc_symlinks.sh")],
                env=env,
            )
        run_command([str(desktop_root / "prepare_fake_sd_root.sh")], env=env)
        run_command(
            ["make", "-C", str(nextui_root), "build", "PLATFORM=desktop"],
            env=env,
        )
        prefix_local.mkdir(parents=True, exist_ok=True)
        setup_marker.touch()
        print("Desktop workspace setup complete.")

    run_command(["make", "-C", str(desktop_root / "libmsettings"), "build"], env=env)
    run_command(["make", "-C", str(ROOT / "src"), "PLATFORM=desktop"], env=env)


def build_platforms(platforms, runtime="docker"):
    for platform in platforms:
        print("== Building {} ==".format(platform), flush=True)
        if platform == "desktop":
            build_desktop()
        else:
            build_device(platform, runtime)


def parse_manifest(platforms):
    entries = []
    missing = []
    for line_number, raw_line in enumerate(MANIFEST.read_text().splitlines(), 1):
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue

        condition = None
        match = re.match(r"^\[([^]]+)\]\s+(.+)$", line)
        if match:
            condition, line = match.groups()
            if condition not in platforms:
                continue

        patterns = []
        if "{platform}" in line:
            patterns.extend(line.replace("{platform}", platform) for platform in platforms)
        else:
            patterns.append(line)

        for pattern in patterns:
            absolute_pattern = str(ROOT / pattern)
            matches = sorted(Path(path) for path in glob.glob(absolute_pattern, recursive=True))
            matches = [path for path in matches if path.is_file() or path.is_symlink()]
            if not matches:
                missing.append("{}:{}: {}".format(MANIFEST.name, line_number, pattern))
                continue
            for path in matches:
                resolved = path.resolve()
                try:
                    resolved.relative_to(ROOT)
                except ValueError:
                    raise DevError("Manifest entry escapes the repository: " + str(path))
                entries.append(path.relative_to(ROOT))
    return unique(entries), missing


def stage_package(platforms, strict):
    platforms = tuple(unique(platforms))
    if DIST_PAK.exists():
        shutil.rmtree(DIST_PAK)
    DIST_PAK.mkdir(parents=True, exist_ok=True)

    entries, missing = parse_manifest(platforms)
    if missing:
        message = "Manifest patterns with no matches:\n  " + "\n  ".join(missing)
        if strict:
            raise DevError(message)
        print("WARNING: " + message, file=sys.stderr)

    for relative in entries:
        source = ROOT / relative
        destination = DIST_PAK / relative
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, destination, follow_symlinks=True)

    if strict:
        actual = {
            path.relative_to(DIST_PAK)
            for path in DIST_PAK.rglob("*")
            if path.is_file() or path.is_symlink()
        }
        expected = set(entries)
        extra = sorted(actual - expected)
        absent = sorted(expected - actual)
        if extra or absent:
            lines = []
            if extra:
                lines.append("Unexpected files:\n  " + "\n  ".join(map(str, extra)))
            if absent:
                lines.append("Missing files:\n  " + "\n  ".join(map(str, absent)))
            raise DevError("\n".join(lines))

    return DIST_PAK


def create_zip(package_dir):
    DIST_DIR.mkdir(parents=True, exist_ok=True)
    if DIST_ZIP.exists():
        DIST_ZIP.unlink()
    with zipfile.ZipFile(DIST_ZIP, "w", compression=zipfile.ZIP_DEFLATED) as archive:
        for path in sorted(package_dir.rglob("*")):
            if path.is_file():
                archive.write(path, path.relative_to(package_dir))
    return DIST_ZIP


def extract_package(archive, destination):
    destination.mkdir(parents=True, exist_ok=True)
    with zipfile.ZipFile(archive) as bundle:
        for info in bundle.infolist():
            extracted = Path(bundle.extract(info, destination))
            mode = (info.external_attr >> 16) & 0o7777
            if mode:
                extracted.chmod(mode)
    return destination


def remote_pak_path(platform):
    return "{}/{}/{}".format(REMOTE_ROOT, platform, PAK_NAME)


def get_pids(device, process):
    lines = adb_shell(device, "pidof", process, check=False)
    pids = " ".join(lines).split()
    return [pid for pid in pids if pid.isdigit()]


def stop_player(device, restart):
    pids = get_pids(device, "musicplayer.elf")
    if not pids:
        return False
    if restart:
        print("Restarting Music Player on {}".format(device.serial), flush=True)
        adb_shell(device, "touch", RESTART_FLAG)
    adb_shell(device, "kill", "-KILL", *pids)
    return True


def wait_for_nextui(device, timeout=8.0):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        pids = get_pids(device, "nextui.elf")
        if pids:
            return pids
        time.sleep(0.25)
    return []


def launch_from_nextui(device):
    pids = wait_for_nextui(device)
    if not pids:
        raise DevError(
            "nextui.elf is not running on {}. Launch Music Player manually.".format(
                device.serial
            )
        )
    launch_command = "'{}/launch.sh'".format(remote_pak_path(device.platform))
    with tempfile.TemporaryDirectory(prefix="music-player-next-") as temp_dir:
        next_file = Path(temp_dir) / "next"
        next_file.write_bytes(launch_command.encode("utf-8"))
        adb(device, "push", str(next_file), "/tmp/next")
    adb_shell(device, "kill", "-KILL", *pids)


def install_binary(device):
    source = ROOT / "bin" / device.platform / "musicplayer.elf"
    destination_dir = remote_pak_path(device.platform) + "/bin/" + device.platform
    adb_shell(device, "mkdir", "-p", destination_dir)
    print(
        "Uploading binary to {}:{}/musicplayer.elf".format(
            device.serial, destination_dir
        ),
        flush=True,
    )
    adb(device, "push", str(source), destination_dir + "/musicplayer.elf")


def install_full(device, package, delete):
    if delete:
        stop_player(device, restart=False)
        adb_shell(device, "rm", "-rf", remote_pak_path(device.platform))
    adb_shell(
        device, "mkdir", "-p", "{}/{}".format(REMOTE_ROOT, device.platform)
    )
    print(
        "Uploading full pak to {}:{}/{}/".format(
            device.serial, REMOTE_ROOT, device.platform
        ),
        flush=True,
    )
    adb(
        device,
        "push",
        str(package),
        "{}/{}/".format(REMOTE_ROOT, device.platform),
    )


def run_on_device(device):
    if stop_player(device, restart=True):
        return
    launch_from_nextui(device)


def run_desktop():
    prefix = "/var/tmp/nextui"
    env = os.environ.copy()
    for name in ("LD_LIBRARY_PATH", "DYLD_LIBRARY_PATH"):
        current = env.get(name, "")
        env[name] = prefix + "/lib" + ((":" + current) if current else "")
    (Path(prefix) / "sdcard/.userdata/shared").mkdir(parents=True, exist_ok=True)
    (Path(prefix) / "sdcard/.userdata/desktop").mkdir(parents=True, exist_ok=True)
    return run_command([str(ROOT / "bin/desktop/musicplayer.elf")], env=env).returncode


