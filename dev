class DevError(Exception):
    pass


class CommandHelpFormatter(argparse.HelpFormatter):
    def _format_action(self, action):
        if isinstance(action, argparse._SubParsersAction):
            format_action = super()._format_action
            return "".join(
                format_action(command) for command in action._get_subactions()
            )
        return super()._format_action(action)


@dataclass(frozen=True)
class Device:
    serial: str
    state: str
    platform: str = "unknown"
    hardware: str = "-"


def load_container_runtime():
    runtime = DEFAULT_CONTAINER_RUNTIME
    if not DEV_CONFIG_FILE.exists():
        return runtime

    for line_number, raw_line in enumerate(
        DEV_CONFIG_FILE.read_text(encoding="utf-8").splitlines(), start=1
    ):
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        if "=" not in line:
            raise DevError(".dev:{}: expected KEY=VALUE".format(line_number))
        key, value = (part.strip() for part in line.split("=", 1))
        if key != "CONTAINER_RUNTIME":
            raise DevError(".dev:{}: unknown setting {}".format(line_number, key))
        runtime = value

    if runtime not in ("docker", "podman"):
        raise DevError(".dev: CONTAINER_RUNTIME must be docker or podman")
    return runtime


def container_runtime(args):
    return args.container_runtime or load_container_runtime()


def run_command(args, cwd=ROOT, env=None, capture=False, check=True, stdin=None):
    if capture:
        result = subprocess.run(
            args,
            cwd=str(cwd),
            env=env,
            input=stdin,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
    else:
        result = subprocess.run(
            args,
            cwd=str(cwd),
            env=env,
            input=stdin,
            check=False,
        )
    if check and result.returncode:
        if capture and result.stderr:
            sys.stderr.write(result.stderr.decode(errors="replace"))
        raise DevError("Command failed: " + " ".join(shlex.quote(str(a)) for a in args))
    return result


@dataclass(frozen=True)
class Dependency:
    name: str
    path: str
    git_url: str
    ref: str

    @property
    def root(self):
        return ROOT / self.path

    @property
    def pin_file(self):
        return self.root / PIN_FILE_NAME

    @property
    def make_root(self):
        """NEXTUI_ROOT as the makefile sees it, relative to src/."""
        return "../{}/workspace".format(self.path)


@dataclass(frozen=True)
class PinStatus:
    dependency: Dependency
    state: str
    detail: str


def colorize(text, color):
    if not sys.stdout.isatty():
        return text
    return color + text + "\033[0m"


def short(commit):
    return commit[:8]


def load_dependencies():
    """Read the build dependencies, each pinned to a tag, branch, or commit."""
    if not DEPS_MANIFEST.exists():
        raise DevError("Missing " + DEPS_MANIFEST.name)

    try:
        with DEPS_MANIFEST.open(encoding="utf-8") as source:
            manifest = json.load(source)
    except (OSError, json.JSONDecodeError) as error:
        raise DevError("{}: {}".format(DEPS_MANIFEST.name, error))

    dependencies = []
    for index, entry in enumerate(manifest.get("dependencies", [])):
        missing = [
            key for key in ("name", "path", "git_url", "ref") if key not in entry
        ]
        if missing:
            raise DevError(
                "{}: dependency {} is missing {}".format(
                    DEPS_MANIFEST.name, index, ", ".join(missing)
                )
            )
        dependencies.append(
            Dependency(entry["name"], entry["path"], entry["git_url"], entry["ref"])
        )

    if not dependencies:
        raise DevError(DEPS_MANIFEST.name + " lists no dependencies")
    return dependencies


def select_dependency(dependencies, name):
    if name is None:
        if len(dependencies) == 1:
            return dependencies[0]
        raise DevError(
            "Name the dependency: " + ", ".join(d.name for d in dependencies)
        )
    for dependency in dependencies:
        if dependency.name == name:
            return dependency
    raise DevError("Unknown dependency: " + name)


def nextui_dependency(platform=None):
    name = PLATFORM_DEPENDENCIES.get(platform, "nextui")
    return select_dependency(load_dependencies(), name)


def git(root, *args, check=True):
    """Run git in a checkout and return its stdout, minus trailing newlines.
    Leading whitespace is significant - `status --porcelain` encodes the staged
    state in column one."""
    command = ["git", "-C", str(root)] + [str(arg) for arg in args]
    result = run_command(command, capture=True, check=check)
    return result.stdout.decode(errors="replace").rstrip()


def git_succeeds(root, *args):
    command = ["git", "-C", str(root)] + [str(arg) for arg in args]
    return run_command(command, capture=True, check=False).returncode == 0


def read_pin(dependency):
    """Parse the pin marker, or None when the checkout is user-managed."""
    if not dependency.pin_file.exists():
        return None
    values = {}
    for raw_line in dependency.pin_file.read_text().splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = (part.strip() for part in line.split("=", 1))
        values[key] = value
    return values


def write_pin(dependency, ref, commit):
    """Record how the checkout was fetched and exactly what it sits on."""
    dependency.pin_file.write_text(
        "# Written by ./dev deps. Editing or removing this file marks the\n"
        "# checkout as user-managed, and every build warns about it.\n"
        "name={}\ngit_url={}\nref={}\ncommit={}\n".format(
            dependency.name, dependency.git_url, ref, commit
        )
    )
    exclude_pin(dependency)


def exclude_pin(dependency):
    """Keep the marker out of the dependency's own git status."""
    exclude = dependency.root / ".git" / "info" / "exclude"
    if not exclude.parent.is_dir():
        return
    lines = exclude.read_text().splitlines() if exclude.exists() else []
    if PIN_FILE_NAME in lines:
        return
    lines.append(PIN_FILE_NAME)
    exclude.write_text("\n".join(lines) + "\n")


def dependency_stamp(dependency):
    """File whose mtime tracks when the checkout last moved."""
    for candidate in (dependency.pin_file, dependency.root / ".git" / "HEAD"):
        if candidate.exists():
            return candidate
    return None


def dependency_status(dependency):
    """Classify a checkout as missing, pinned, stale (pin moved on), or unpinned."""
    root = dependency.root
    if not root.is_dir():
        return PinStatus(dependency, "missing", "not checked out")
    if not (root / ".git").exists():
        return PinStatus(dependency, "unpinned", "not a git checkout")

    head = git(root, "rev-parse", "HEAD", check=False)
    if not head:
        return PinStatus(dependency, "unpinned", "no HEAD commit")

    dirty = bool(git(root, "status", "--porcelain", "--untracked-files=no"))
    where = (
        "{} with local changes".format(short(head))
        if dirty
        else "clean checkout of {}".format(short(head))
    )

    pin = read_pin(dependency)
    if not pin:
        return PinStatus(dependency, "unpinned", "no pin marker, " + where)

    ref = pin.get("ref", "")
    if pin.get("commit") != head:
        return PinStatus(
            dependency,
            "unpinned",
            "{}, not the pinned {} ({})".format(
                where, ref or "?", short(pin.get("commit", "?"))
            ),
        )
    if ref != dependency.ref:
        return PinStatus(
            dependency,
            "stale",
            "on {}, manifest pins {}".format(ref, dependency.ref),
        )
    if dirty:
        return PinStatus(
            dependency, "modified", "{} with local changes".format(ref)
        )
    return PinStatus(dependency, "pinned", "{} ({})".format(ref, short(head)))


def describe(status):
    """Name the dependency and where it lives, then what it is sitting on."""
    return "{} at {}/ - {}".format(
        status.dependency.name, status.dependency.path, status.detail
    )


def warn_unpinned(statuses):
    lines = ["MODIFIED DEPENDENCY"]
    for status in statuses:
        lines.append(describe(status))
    lines.append("Run ./dev deps fetch --force to restore the checkout.")
    width = max(len(line) for line in lines) + 4
    border = "!" * width
    block = [border]
    block.extend("! " + line.ljust(width - 4) + " !" for line in lines)
    block.append(border)
    print(colorize("\n".join(block), YELLOW), file=sys.stderr, flush=True)


def resolve_ref(root, ref):
    """Resolve a ref to a commit. Branches must resolve to the remote tip, so
    origin/<ref> wins; tags and raw revisions fall through to the bare name."""
    for candidate in ("origin/" + ref, ref):
        commit = git(
            root, "rev-parse", "--verify", "--quiet", candidate + "^{commit}",
            check=False,
        )
        if commit:
            return commit
    return ""


def checkout_dependency(dependency, ref, commit):
    """Detach onto commit, warning when local edits are carried across."""
    root = dependency.root
    if git(root, "status", "--porcelain", "--untracked-files=no", check=False):
        print(
            colorize(
                "WARNING: {} has modified files; they are carried over".format(
                    dependency.path
                ),
                YELLOW,
            ),
            file=sys.stderr,
            flush=True,
        )

    print(
        "Checking out {} at {} ({})".format(dependency.name, ref, short(commit)),
        flush=True,
    )
    result = run_command(
        ["git", "-C", str(root), "checkout", "--detach", commit],
        capture=True,
        check=False,
    )
    if result.returncode:
        raise DevError(
            "{}: cannot switch to {} ({})\n{}".format(
                dependency.name,
                ref,
                short(commit),
                result.stderr.decode(errors="replace").strip(),
            )
        )
    write_pin(dependency, ref, commit)


def clone_dependency(dependency):
    print(
        "Cloning {} into {}".format(dependency.git_url, dependency.path), flush=True
    )
    run_command(["git", "clone", dependency.git_url, str(dependency.root)])
    commit = resolve_ref(dependency.root, dependency.ref)
    if not commit:
        raise DevError(
            "{}: {} is not in {}".format(
                dependency.name, dependency.ref, dependency.git_url
            )
        )
    checkout_dependency(dependency, dependency.ref, commit)


def fetch_dependency(dependency):
    """Make the checkout exist, without touching the network when it already
    does. A ref edited in the manifest is followed only if it already resolves
    locally; anything needing the remote is `./dev deps update`."""
    status = dependency_status(dependency)
    if status.state == "missing":
        clone_dependency(dependency)
        return True

    if status.state != "stale":
        return False

    commit = resolve_ref(dependency.root, dependency.ref)
    if not commit:
        print(
            "{}: {} is not fetched yet - run ./dev deps update".format(
                dependency.name, dependency.ref
            ),
            file=sys.stderr,
        )
        return False

    print("{} ref moved: {}".format(dependency.name, status.detail), flush=True)
    checkout_dependency(dependency, dependency.ref, commit)
    return True


def update_dependency(dependency):
    """Refresh from the remote and move onto whatever the ref resolves to now."""
    root = dependency.root
    if not root.is_dir():
        clone_dependency(dependency)
        return

    status = dependency_status(dependency)
    if status.state == "unpinned":
        warn_unpinned([status])
        print(
            "{}: leaving the checkout alone".format(dependency.name), file=sys.stderr
        )
        return

    print("Updating " + dependency.name, flush=True)
    run_command(["git", "-C", str(root), "remote", "update", "--prune"])
    run_command(["git", "-C", str(root), "fetch", "--tags", "origin"])

    commit = resolve_ref(root, dependency.ref)
    if not commit:
        raise DevError(
            "{}: {} is not in {}".format(
                dependency.name, dependency.ref, dependency.git_url
            )
        )

    pin = read_pin(dependency) or {}
    if commit == pin.get("commit"):
        print(
            "{}: {} is unchanged ({})".format(
                dependency.name, dependency.ref, short(commit)
            )
        )
        if pin.get("ref") != dependency.ref:
            write_pin(dependency, dependency.ref, commit)
        return

    print(
        colorize(
            "{}: {} moved {} -> {} - rebuild and retest, the API may have "
            "changed".format(
                dependency.name,
                dependency.ref,
                short(pin.get("commit", "?")),
                short(commit),
            ),
            YELLOW,
        ),
        file=sys.stderr,
        flush=True,
    )
    checkout_dependency(dependency, dependency.ref, commit)


def resolve_dependency_checkouts():
    """Bring stale pins forward and report what every checkout is sitting on."""
    statuses = []
    for dependency in load_dependencies():
        fetch_dependency(dependency)
        statuses.append(dependency_status(dependency))

    missing = [status for status in statuses if status.state == "missing"]
    if missing:
        raise DevError(
            "Not checked out: {}. Run ./dev deps fetch.".format(
                ", ".join(status.dependency.path for status in missing)
            )
        )

    unpinned = [status for status in statuses if status.state != "pinned"]
    if unpinned:
        warn_unpinned(unpinned)
    return statuses


CHECKED_DEPENDENCIES = []


def check_dependencies(strict=False):
    """Verify (and refresh) dependency checkouts once per run."""
    global CHECKED_DEPENDENCIES
    if not CHECKED_DEPENDENCIES:
        CHECKED_DEPENDENCIES = resolve_dependency_checkouts()

    if strict:
        unpinned = [s for s in CHECKED_DEPENDENCIES if s.state != "pinned"]
        if unpinned:
            raise DevError(
                "A release build needs pinned dependencies: "
                + "; ".join(describe(status) for status in unpinned)
                + ". Run ./dev deps fetch --force, or pass --allow-unpinned."
            )
    return CHECKED_DEPENDENCIES


def selected_dependencies(name):
    dependencies = load_dependencies()
    if name in (None, "all"):
        return dependencies
    return [select_dependency(dependencies, name)]


def command_deps_list(args):
    for dependency in selected_dependencies(args.dependency):
        status = dependency_status(dependency)
        print(
            "{} at {}/ - {}, {}".format(
                dependency.name, dependency.path, status.state, status.detail
            )
        )
    return 0


def command_deps_fetch(args):
    unpinned = []
    for dependency in selected_dependencies(args.dependency):
        if args.force:
            restore_dependency(dependency)
            continue

        if fetch_dependency(dependency):
            continue

        status = dependency_status(dependency)
        if status.state == "pinned":
            print(describe(status))
        else:
            unpinned.append(status)

    if unpinned:
        warn_unpinned(unpinned)
        print(
            "Leaving the checkout alone. Remove local changes and use --force to restore it.",
            file=sys.stderr,
        )
    return 0


def confirm(question):
    """Ask a yes/no question. False when there is nobody to ask."""
    if not sys.stdin.isatty():
        return False
    try:
        answer = input(question + " [y/N] ")
    except EOFError:
        return False
    return answer.strip().lower() in ("y", "yes")


def restore_dependency(dependency):
    """Put a user-managed checkout back on the manifest ref."""
    if not dependency.root.is_dir():
        clone_dependency(dependency)
        return
    if dependency.root.is_symlink():
        print(
            "{} is a symlink; restoring inside the linked tree".format(
                dependency.path
            ),
            flush=True,
        )
    changes = git(
        dependency.root, "status", "--porcelain", "--untracked-files=no", check=False
    )
    if changes:
        print("{} has local changes:".format(dependency.path))
        print(changes)
        if not confirm("Discard them?"):
            raise DevError(
                "{} has local changes - commit or discard them before --force".format(
                    dependency.path
                )
            )
        run_command(["git", "-C", str(dependency.root), "reset", "--hard", "--quiet"])

    commit = resolve_ref(dependency.root, dependency.ref)
    if not commit:
        raise DevError(
            "{}: {} is not fetched - run ./dev deps update".format(
                dependency.name, dependency.ref
            )
        )
    checkout_dependency(dependency, dependency.ref, commit)


def command_deps_update(args):
    for dependency in selected_dependencies(args.dependency):
        update_dependency(dependency)
    return 0


def command_deps(args):
    if args.deps_handler is None:
        args.command_parser.print_help()
        return 0
    return args.deps_handler(args)


def adb(device, *args, check=True):
    """Run ADB and return stdout as a list of lines.

    ADB emits CRLF on some hosts; carriage returns are removed before splitting.
    """
    command = ["adb"]
    if device is not None:
        command.extend(["-s", device.serial])
    command.extend(str(arg) for arg in args)
    result = run_command(command, capture=True, check=check)
    return result.stdout.decode(errors="replace").replace("\r", "").splitlines()


def adb_shell(device, *args, check=True):
    """Run one safely quoted device command and return normalized output lines."""
    command = shlex.join(str(arg) for arg in args)
    return adb(device, "shell", command, check=check)


def list_devices(detect_platforms=True):
    devices = []
    for line in adb(None, "devices")[1:]:
        fields = line.split()
        if len(fields) < 2:
            continue
        serial, state = fields[:2]
        device = Device(serial=serial, state=state)
        if state == "device" and detect_platforms:
            device = detect_device(device)
        devices.append(device)
    return devices


def detect_device(device):
    cpuinfo = "\n".join(adb_shell(device, "cat", "/proc/cpuinfo", check=False))
    platform = "unknown"
    hardware = "-"
    for identifier, candidate in CPUINFO_PLATFORMS.items():
        if identifier in cpuinfo:
            platform = candidate
            hardware = identifier
            break

    return Device(
        serial=device.serial,
        state=device.state,
        platform=platform,
        hardware=hardware,
    )


def normalize_alias(value):
    return re.sub(r"[\s_-]+", "", value).lower()


def platform_for_alias(value):
    key = normalize_alias(value)
    for platform, aliases in ALIASES.items():
        if any(key == normalize_alias(alias) for alias in aliases):
            return platform
    return None


def unique(values):
    return list(dict.fromkeys(values))


def resolve_build_platforms(values, default=("desktop",), allow_all=True):
    values = values or list(default)
    platforms = []
    for value in values:
        key = normalize_alias(value)
        if key == "all":
            if not allow_all:
                raise DevError("'all' is not valid for this command")
            platforms.extend(ALL_PLATFORMS)
            continue
        platform = platform_for_alias(key)
        if not platform:
            raise DevError("Unknown platform: " + value)
        platforms.append(platform)
    return unique(platforms)


def resolve_dist_platforms(values):
    values = values or ["all"]
    platforms = []
    for value in values:
        key = normalize_alias(value)
        if key == "all":
            platforms.extend(DEVICE_PLATFORMS)
            continue
        platform = platform_for_alias(key)
        if platform not in DEVICE_PLATFORMS:
            raise DevError("Invalid distribution platform: " + value)
        platforms.append(platform)
    return unique(platforms)


def resolve_device_targets(values, devices, allow_desktop):
    ready = [device for device in devices if device.state == "device"]
    by_serial = {device.serial: device for device in devices}
    build_platforms = []
    targets = []

    for value in values:
        key = normalize_alias(value)
        if key == "device":
            selected = [device for device in ready if device.platform in DEVICE_PLATFORMS]
            if not selected:
                raise DevError("No supported ADB devices are connected")
            targets.extend(selected)
            build_platforms.extend(device.platform for device in selected)
            continue

        platform = platform_for_alias(key)
        if platform:
            if platform == "desktop":
                if not allow_desktop:
                    raise DevError("desktop is not valid for this command")
                build_platforms.append(platform)
                continue
            selected = [device for device in ready if device.platform == platform]
            if not selected:
                raise DevError("No connected device matches " + platform)
            targets.extend(selected)
            build_platforms.append(platform)
            continue

        device = by_serial.get(value)
        if not device:
            raise DevError("Unknown platform, alias, or ADB serial: " + value)
        if device.state != "device":
            raise DevError("ADB device {} is {}".format(value, device.state))
        if device.platform not in DEVICE_PLATFORMS:
            raise DevError("Could not detect the platform for ADB device " + value)
        targets.append(device)
        build_platforms.append(device.platform)

    targets = list({device.serial: device for device in targets}.values())
    return unique(build_platforms), targets


def run_container(runtime, platform, command, check=True):
    container_command = [runtime, "run"]
    if sys.stdin.isatty() and sys.stdout.isatty():
        container_command.append("-it")
    container_command.extend(["-v", "{}:{}".format(ROOT, CONTAINER_PROJECT)])
    for dependency in load_dependencies():
        if not dependency.root.is_dir():
            raise DevError(
                "{} is not checked out. Run ./dev deps fetch.".format(dependency.path)
            )
        container_command.extend(
            [
                "-v",
                "{}:{}/{}".format(
                    dependency.root.resolve(), CONTAINER_PROJECT, dependency.path
                ),
            ]
        )
    container_command.extend(
        [
            "-w",
            CONTAINER_PROJECT,
            "--rm",
            "ghcr.io/loveretro/{}-toolchain".format(platform),
        ]
    )
    container_command.extend(command)
    return run_command(container_command, check=check)


def build_device(platform, runtime):
    build_dir = ROOT / "src" / "build" / platform
    build_dir.mkdir(parents=True, exist_ok=True)
    if platform in AAC_PREBUILT_PLATFORMS:
        aac_library = ROOT / "bin" / platform / "libfdk-aac.so.1"
        if not aac_library.exists():
            raise DevError("Missing {}".format(aac_library.relative_to(ROOT)))

        staged = build_dir / aac_library.name
        if not staged.exists():
            print("Copying {}".format(aac_library.relative_to(ROOT)))
            shutil.copy2(aac_library, staged)

        link = build_dir / "libfdk-aac.so"
        if not link.exists() or not link.is_symlink:
            print("Symlinking {}".format(link.relative_to(ROOT)))
            link.unlink(missing_ok=True)
            link.symlink_to(aac_library.name)

