def command_radio_check(args):
    selector = args.selector
    if selector.startswith(("http://", "https://")):
        return check_radio_url(selector)
    if selector.lower() == "all":
        catalogs = sorted((ROOT / "stations").glob("*.json"))
        if not catalogs:
            raise DevError("No radio catalogs found")
        return 1 if sum(check_radio_catalog(path) for path in catalogs) else 0
    return 1 if check_radio_catalog(resolve_radio_catalog(selector)) else 0


